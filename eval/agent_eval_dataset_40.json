  "multi_turn_scenarios": [
    {
      "id": "multi_001",
      "category": "memory_user_profile",
      "turns": [
        {
          "query": "请记住，我是用户1001。",
          "required_tools": ["save_memory_context"],
          "expected_arguments": {
            "save_memory_context": {"user_id": "1001"}
          },
          "expected_memory": {"user_id": "1001"}
        },
        {
          "query": "查询我的用户画像，请先读取当前会话记忆。",
          "required_tools": [
            "get_memory_context",
            "get_user_profile_from_db"
          ],
          "expected_arguments": {
            "get_user_profile_from_db": {"user_id": "1001"}
          },
          "expected_memory": {"user_id": "1001"},
          "memory_inheritance": true
        }
      ]
    },
    {
      "id": "multi_002",
      "category": "memory_city_weather",
      "turns": [
        {
          "query": "请记住，我在合肥。",
          "required_tools": ["save_memory_context"],
          "expected_arguments": {
            "save_memory_context": {"city": "合肥"}
          },
          "expected_memory": {"city": "合肥"}
        },
        {
          "query": "我所在城市天气怎么样？请先读取会话记忆。",
          "required_tools": [
            "get_memory_context",
            "get_weather"
          ],
          "expected_arguments": {
            "get_weather": {"city": "合肥"}
          },
          "expected_memory": {"city": "合肥"},
          "memory_inheritance": true
        }
      ]
    },
    {
      "id": "multi_003",
      "category": "memory_records",
      "turns": [
        {
          "query": "请记住，我是用户1003，要查询2025-06。",
          "required_tools": ["save_memory_context"],
          "expected_arguments": {
            "save_memory_context": {
              "user_id": "1003",
              "month": "2025-06"
            }
          },
          "expected_memory": {
            "user_id": "1003",
            "month": "2025-06"
          }
        },
        {
          "query": "查询我这个月的清扫记录，请先读取当前会话记忆并使用MySQL工具。",
          "required_tools": [
            "get_memory_context",
            "get_cleaning_records_from_db"
          ],
          "expected_arguments": {
            "get_cleaning_records_from_db": {
              "user_id": "1003",
              "month": "2025-06"
            }
          },
          "expected_memory": {
            "user_id": "1003",
            "month": "2025-06"
          },
          "memory_inheritance": true
        }
      ]
    },
    {
      "id": "multi_004",
      "category": "memory_overwrite",
      "turns": [
        {
          "query": "请记住，我是用户1001。",
          "required_tools": ["save_memory_context"],
          "expected_memory": {"user_id": "1001"}
        },
        {
          "query": "现在切换为用户1002，请更新记忆。",
          "required_tools": ["save_memory_context"],
          "expected_arguments": {
            "save_memory_context": {"user_id": "1002"}
          },
          "expected_memory": {"user_id": "1002"}
        },
        {
          "query": "查询我绑定的设备，请先读取记忆并使用MySQL工具。",
          "required_tools": [
            "get_memory_context",
            "get_user_devices_from_db"
          ],
          "expected_arguments": {
            "get_user_devices_from_db": {"user_id": "1002"}
          },
          "expected_memory": {"user_id": "1002"},
          "memory_inheritance": true
        }
      ]
    },
    {
      "id": "multi_005",
      "category": "memory_clear",
      "turns": [
        {
          "query": "请记住，我是用户1005，我在郑州。",
          "required_tools": ["save_memory_context"],
          "expected_memory": {
            "user_id": "1005",
            "city": "郑州"
          }
        },
        {
          "query": "清空当前会话记忆。",
          "required_tools": ["clear_memory_context"],
          "expected_memory": {}
        }
      ]
    },
    {
      "id": "multi_006",
      "category": "memory_month_overwrite",
      "turns": [
        {
          "query": "请记住，我要查询2025-05。",
          "required_tools": ["save_memory_context"],
          "expected_memory": {"month": "2025-05"}
        },
        {
          "query": "把查询月份改成2025-06。",
          "required_tools": ["save_memory_context"],
          "expected_arguments": {
            "save_memory_context": {"month": "2025-06"}
          },
          "expected_memory": {"month": "2025-06"}
        }
      ]
    },
    {
      "id": "multi_007",
      "category": "session_isolation",
      "session_isolation": true,
      "turns": [
        {
          "session_suffix": "a",
          "query": "请记住，我是用户1001。",
          "required_tools": ["save_memory_context"],
          "expected_memory": {"user_id": "1001"}
        },
        {
          "session_suffix": "b",
          "query": "请记住，我是用户1002。",
          "required_tools": ["save_memory_context"],
          "expected_memory": {"user_id": "1002"}
        },
        {
          "session_suffix": "a",
          "query": "读取当前会话记忆，并告诉我用户ID。",
          "required_tools": ["get_memory_context"],
          "expected_memory": {"user_id": "1001"},
          "memory_inheritance": true
        }
      ]
    }
  ]
